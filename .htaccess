# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php74" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php74 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# ------------------------------------------------------------------
# Force HTTPS — the admin password and session cookie must never travel in
# cleartext. This host's cPanel theme has no "Force HTTPS" toggle exposed,
# so it's enforced here instead. %{HTTPS} off covers both a plain :80
# request and any proxy that terminates TLS upstream without setting it.
# ------------------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# The home page is index.php. Named explicitly: the old index.html may still
# sit in public_html from earlier deploys, and must never win.
DirectoryIndex index.php

# inc/ holds the page shell and shared PHP — included by pages, never
# requested directly.
RewriteRule ^inc(/|$) - [F,L]

# ------------------------------------------------------------------
# Clean URLs — agrofarm.mn/news instead of agrofarm.mn/news.php
# ------------------------------------------------------------------

# 1) Old or direct file addresses get a permanent redirect to the clean one,
#    so each page has one canonical address (bookmarks, shared links, search
#    engines). The query string rides along — /shop.html?order=… links in
#    customers' hands still open their order.
RewriteCond %{THE_REQUEST} \s/+index\.(html|php)[\s?] [NC]
RewriteRule ^ /? [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(admin|news|shop)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(news|shop)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# A trailing slash (/admin/) must also collapse to the one canonical address
# — admin.html's CSS/JS tags and admin.js's fetch() calls use relative
# paths, so leaving the address bar on /admin/ instead of /admin would
# resolve them one directory too deep and break the page.
RewriteCond %{THE_REQUEST} \s/+(admin|news|shop)/[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2) Serve the page behind each clean URL. The address bar keeps the clean URL.
RewriteRule ^admin/?$ admin.html [L]
RewriteRule ^news/?$ news.php [L]
RewriteRule ^shop/?$ shop.php [L]

# ------------------------------------------------------------------
# Shop — one address scheme for everything we sell:
#   /shop                                    storefront
#   /shop/<product>                          a priced product
#   /shop/equipment                          equipment catalogue
#   /shop/equipment/<category>               one category
#   /shop/equipment/<category>/<product>     one equipment product
# The catalogue used to live at /equipment/…; those addresses redirect.
# Slugs are lowercase latin + digits + hyphen; anything else falls through
# to a normal 404 rather than reaching PHP.
# ------------------------------------------------------------------
RewriteRule ^equipment(/.*)?$ /shop/equipment$1 [R=301,L]
RewriteRule ^shop/equipment/?$ equipment.php [L]
RewriteRule ^shop/equipment/([a-z0-9-]+)/?$ category.php?cat=$1 [QSA,L]
RewriteRule ^shop/equipment/([a-z0-9-]+)/([a-z0-9-]+)/?$ product.php?cat=$1&slug=$2 [QSA,L]
RewriteRule ^shop/([a-z0-9-]+)/?$ shop-product.php?slug=$1 [QSA,L]

# ------------------------------------------------------------------
# Security headers
# ------------------------------------------------------------------
<IfModule mod_headers.c>
  # Clickjacking protection — most relevant for /admin, which has no other
  # defense against being iframed and used for UI-redressing tricks.
  Header always set X-Frame-Options "SAMEORIGIN"
  # Stops a browser from ever guessing a response is executable content
  # based on sniffed bytes rather than the real Content-Type header.
  Header always set X-Content-Type-Options "nosniff"
  # Cross-origin requests (e.g. a link from another site) still get the
  # bare origin; same-origin navigation keeps the full URL for analytics.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Never list a directory's contents when it has no index file — img/news/
# and img/products/ are public but their filenames are meant to be looked
# up individually (from news-data.json / the products API), not browsed.
Options -Indexes

# Block direct access to any stray backup/editor-swap file. Apache only runs
# the PHP handler for the extensions registered above (.php/.php7/.phtml) —
# a file like config.php.bak or login.php~ would otherwise be served as
# plain, unprocessed text if one was ever accidentally left in this folder.
<FilesMatch "(\.bak|\.old|\.orig|\.save|~|\.swp)$">
  Require all denied
</FilesMatch>
